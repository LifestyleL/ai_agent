# 统一API配置管理
# 请将您的API密钥填写在下方，所有密钥都应以'sk-'开头

# DeepSeek API配置（用于工具调用）
# DEEPSEEK_API_KEY=sk-561ccdcc5e554f1f8e0e1ee3bc2c15d9
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# # 阿里千问API配置（用于人设对话）
# QWEN_API_KEY=sk-e085d42117d54757b1bab199143cf10f
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-max

# # 阿里DashScope TTS配置（用于语音合成）
# DASHSCOPE_API_KEY=sk-5b9b78c3ef384435aa4533bddeafbb91
# TTS_MODEL=qwen3-tts-vd-realtime-2026-01-15
# TTS_VOICE=qwen-tts-vd-live2d_girl-voice-20260413174053978-a5da
# TTS_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# AI Agent 后端环境变量配置
# 复制此文件为 .env 并填写实际值

# ==================== DeepSeek API配置 ====================
# DeepSeek API密钥（用于工具调用）
DEEPSEEK_API_KEY=sk-561ccdcc5e554f1f8e0e1ee3bc2c15d9

# DeepSeek API基础URL（通常使用默认值）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek模型名称（通常使用默认值）
DEEPSEEK_MODEL=deepseek-chat

# ==================== 阿里千问API配置 ====================
# 阿里千问API密钥（用于人格对话）
QWEN_API_KEY=sk-5c127f063ed0426cb91c9fa8915b95ed

# 千问API基础URL（通常使用默认值）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 千问模型名称（qwen-max, qwen-plus, qwen-turbo等）
QWEN_MODEL=qwen-max

# ==================== 阿里DashScope TTS配置 ====================
# DashScope TTS API密钥（用于语音合成）
DASHSCOPE_API_KEY=sk-329aa761ca6649a98c9f1ab5a452d53e

# TTS模型名称（通常使用默认值）
TTS_MODEL=qwen3-tts-vd-realtime-2026-01-15

# TTS声音ID（自定义声音，通常使用默认值）
TTS_VOICE=qwen-tts-vd-live2d_girl-voice-20260413174053978-a5da

# TTS WebSocket基础URL（通常使用默认值）
TTS_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# ==================== Agent行为配置 ====================
# 空闲超时（秒）：多久没有用户输入时触发独白
AGENT_IDLE_TIMEOUT=20

# 独白间隔最小值（秒）
AGENT_IDLE_INTERVAL_MIN=60

# 独白间隔最大值（秒）
AGENT_IDLE_INTERVAL_MAX=65

# ==================== WebSocket JSON-RPC配置 ====================
# 是否启用JSON-RPC响应包装
ENABLE_JSONRPC_RESPONSE=false

# ==================== 环境配置 ====================
# 应用环境：development（开发）或 production（生产）
# 决定加载哪个YAML配置文件（config/development.yaml 或 config/production.yaml）
APP_ENV=development