{
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "node copy_resources.js && vite",
    "dev": "node copy_resources.js && vite",
    "electron:dev": "node copy_resources.js && vite",
    "electron:launch": "node electron-launch.js",
    "electron:build": "tsc --noEmit && node copy_resources.js && vite build --mode development && electron-builder",
    "build": "tsc --noEmit && node copy_resources.js && vite build --mode development",
    "build:prod": "node copy_resources.js && vite build",
    "copy_resources": "node copy_resources.js",
    "test": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "serve": "vite preview --port 5000",
    "clean": "rimraf dist dist-electron"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^25.5.0",
    "electron": "^41.5.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "optionalDependencies": {
    "fsevents": "*"
  },
  "dependencies": {
    "lit": "^3.3.2"
  }
}
